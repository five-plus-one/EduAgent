# =============================================
# EduAgent Frontend — 环境变量模板
# 复制此文件为 .env 并填入实际值
# =============================================

# 后端 API 根地址（含版本前缀）
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 后端服务地址（仅用于 Vite DevServer Proxy，不含路径）
VITE_BACKEND_ORIGIN=http://localhost:8000

# API 请求超时（毫秒）；默认 120000 = 2 分钟
VITE_API_TIMEOUT=120000
